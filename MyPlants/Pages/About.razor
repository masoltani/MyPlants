@page "/about"

@using MyPlants.Services
@using MyPlants.Resources

@inject AppInfoService AppInfo

<PageTitle>@SharedResource.About_Title</PageTitle>

<div class="container">

    <h1>@SharedResource.About_ApplicationName</h1>

    <p class="text-muted">
        @SharedResource.About_Description
    </p>

    <dl class="row">
        <dt class="col-sm-4">Version</dt>
        <dd class="col-sm-8">@AppInfo.Version</dd>
    </dl>

</div>