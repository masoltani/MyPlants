@page "/"

@using MyPlants.Businesses
@using MyPlants.Interfaces.IServices
@using MyPlants.Models
@using MyPlants.Resources

@implements IDisposable

@inject IPlantService PlantService
@inject IUserSessionService UserSessionService

<PageTitle>@SharedResource.About_ApplicationName</PageTitle>

<h1 class="mb-3">@SharedResource.Home_Title</h1>

@if (loadingDue)
{
    <p>@SharedResource.PlantEdit_Loading</p>
}
else if (dueError)
{
    <div class="alert alert-danger" role="alert">@SharedResource.Error_Generic</div>
}
else if (duePlants.Count == 0)
{
    <p class="text-muted">@SharedResource.Home_AllDone</p>
}
else
{
    <ul class="list-group mb-3">
        @foreach (var item in duePlants)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                <div>
                    <a href="@($"plants/{item.Plant.Id}")">@item.Plant.Name</a>
                    <span class="badge @item.CssClass ms-2">@item.Text</span>
                </div>

                <button type="button"
                        class="btn btn-secondary btn-sm"
                        @onclick="() => WaterAsync(item.Plant.Id)"
                        disabled="@(wateringId is not null)">
                    <span aria-hidden="true">💧</span>
                    @SharedResource.Plants_Water
                </button>
            </li>
        }
    </ul>
}

<p>
    <a href="plants">@SharedResource.Home_SeeAllPlants</a>
</p>

@if (isCheckingSession)
{
    <p>@SharedResource.PlantEdit_Loading</p>
}
else if (showGuestImport)
{
    <div class="guest-import-popup" role="dialog"
         aria-labelledby="guest-import-title"
         aria-describedby="guest-import-description">

        <div class="guest-import-content">
            <div class="guest-import-icon">🪴</div>

            <div class="guest-import-text">
                <h3 id="guest-import-title">@SharedResource.GuestImport_Title</h3>

                <p id="guest-import-description">
                    @SharedResource.GuestImport_Description
                </p>

                @if (!string.IsNullOrWhiteSpace(importMessage))
                {
                    <p role="status">@importMessage</p>
                }
            </div>
        </div>

        <div class="guest-import-actions">
            <button class="guest-import-primary"
                    @onclick="ImportGuestPlants"
                    disabled="@isImporting">
                @(isImporting 
                    ? SharedResource.GuestImport_Importing 
                    : SharedResource.GuestImport_Import)
            </button>

            <button class="guest-import-secondary"
                    @onclick="RemindLater"
                    disabled="@isImporting">
                @SharedResource.GuestImport_Later
            </button>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(importMessage))
{
    @* Résultat de l'import, affiché une fois la fenêtre refermée. *@
    <div class="alert alert-success" role="status">
        @importMessage
    </div>
}

@code {
    private sealed record DueItem(Plant Plant, string Text, string CssClass);

    private bool isCheckingSession = true;
    private bool showGuestImport;
    private bool isImporting;
    private string? importMessage;
    private List<DueItem> duePlants = [];
    private bool loadingDue = true;
    private bool dueError;
    private Guid? wateringId;

    protected override async Task OnInitializedAsync()
    {
        await LoadDueAsync();
        UserSessionService.OnSessionChanged += OnSessionChanged;

        try
        {
            await UserSessionService.InitializeAsync();
            await UpdateGuestImportVisibilityAsync();
        }
        finally
        {
            isCheckingSession = false;
        }
    }

    // async void est imposé par le type de l'événement : toute exception doit être
    // rattrapée ici, sinon elle ferait planter l'application.
    private async void OnSessionChanged()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (!UserSessionService.IsLoggedIn)
                {
                    showGuestImport = false;
                    importMessage = null;
                }
                else
                {
                    await UpdateGuestImportVisibilityAsync();
                }

                await LoadDueAsync();
                StateHasChanged();
            });
        }
        catch (Exception)
        {
            showGuestImport = false;
        }
    }

    private async Task UpdateGuestImportVisibilityAsync()
    {
        try
        {
            showGuestImport = UserSessionService.IsLoggedIn
                && await PlantService.HasGuestPlantsAsync();
        }
        catch (Exception)
        {
            // La proposition d'import est facultative : on ne bloque pas l'accueil.
            showGuestImport = false;
        }
    }

    private void RemindLater()
    {
        showGuestImport = false;
    }

    private async Task ImportGuestPlants()
    {
        isImporting = true;
        importMessage = null;

        try
        {
            var count = await PlantService.ImportGuestPlantsAsync();

            showGuestImport = false;
            importMessage = string.Format(SharedResource.GuestImport_Done, count);
        }
        catch (Exception)
        {
            importMessage = SharedResource.GuestImport_Failed;
        }
        finally
        {
            isImporting = false;
        }
    }

    private async Task LoadDueAsync()
    {
        try
        {
            var today = DateTime.Today;
            var plants = await PlantService.GetPlantsAsync();

            duePlants = plants
                .Select(plant => (Plant: plant, Days: PlantSorter.GetDaysUntilWatering(plant, today)))
                .Where(item => item.Days is <= 0)
                .OrderBy(item => item.Days)
                .ThenBy(item => item.Plant.Name ?? string.Empty, StringComparer.CurrentCultureIgnoreCase)
                .Select(item => item.Days < 0
                    ? new DueItem(item.Plant, string.Format(SharedResource.Plants_WaterOverdue, -item.Days), "text-bg-danger")
                    : new DueItem(item.Plant, SharedResource.Plants_WaterToday, "text-bg-warning"))
                .ToList();

            dueError = false;
        }
        catch (Exception)
        {
            dueError = true;
        }
        finally
        {
            loadingDue = false;
        }
    }

    private async Task WaterAsync(Guid id)
    {
        if (wateringId is not null)
            return;

        wateringId = id;

        try
        {
            if (await PlantService.WaterPlantAsync(id))
                await LoadDueAsync();
            else
                dueError = true;
        }
        catch (Exception)
        {
            dueError = true;
        }
        finally
        {
            wateringId = null;
        }
    }

    public void Dispose()
    {
        UserSessionService.OnSessionChanged -= OnSessionChanged;
    }
}
