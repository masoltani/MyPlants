@page "/forgot-password"

@using MyPlants.Interfaces.IServices
@using MyPlants.Resources

@inject IUserSessionService UserSession

<PageTitle>@SharedResource.Auth_ForgotPassword_Title - MyPlants</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h1 class="h3 mb-3 text-center">
                        @SharedResource.Auth_ForgotPassword_Title
                    </h1>

                    @if (sent)
                    {
                        @* Même message que l'adresse existe ou non : on ne révèle pas quels comptes existent. *@
                        <div class="alert alert-success" role="status">
                            @SharedResource.Auth_ResetLinkSent
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">
                            @SharedResource.Auth_ForgotPassword_Description
                        </p>

                        <form @onsubmit="SendAsync"
                              @onsubmit:preventDefault="true">

                            <div class="mb-3">
                                <label for="email" class="form-label">
                                    @SharedResource.Auth_Email
                                </label>

                                <input id="email"
                                       type="email"
                                       class="form-control"
                                       @bind="email"
                                       @bind:event="oninput"
                                       autocomplete="email"
                                       required />
                            </div>

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger" role="alert">
                                    @errorMessage
                                </div>
                            }

                            <button type="submit"
                                    class="btn btn-primary w-100 mb-2"
                                    disabled="@sending">
                                @if (sending)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"
                                          aria-hidden="true"></span>
                                }
                                @SharedResource.Auth_SendResetLink
                            </button>

                        </form>
                    }

                    <a class="btn btn-outline-secondary w-100" href="login">
                        @SharedResource.Auth_BackToLogin
                    </a>

                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string? errorMessage;
    private bool sending;
    private bool sent;

    private async Task SendAsync()
    {
        // Évite l'envoi de plusieurs e-mails en cas de double clic.
        if (sending || string.IsNullOrWhiteSpace(email))
            return;

        sending = true;
        errorMessage = null;

        try
        {
            if (await UserSession.RequestPasswordResetAsync(email.Trim()))
                sent = true;
            else
                errorMessage = UserSession.LastError ?? SharedResource.Error_Generic;
        }
        finally
        {
            sending = false;
        }
    }
}
