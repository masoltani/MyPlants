@page "/plants/{Id:guid}"

@using MyPlants.Models
@using MyPlants.Interfaces.IServices

@inject IPlantService PlantService
@inject NavigationManager Navigation

<PageTitle>@(plant?.Name ?? "Plant Details")</PageTitle>

@if (loading)
{
    <div class="container py-3">
        <p><em>Loading...</em></p>
    </div>
}
else if (plant is null)
{
    <div class="container py-3">
        <div class="alert alert-warning" role="alert">
            Plant not found.
        </div>

        <button class="btn btn-outline-secondary"
                @onclick="BackToPlants">
            ← Back to plants
        </button>
    </div>
}
else
{
    <div class="container py-3">

        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h1>@plant.Name</h1>

                <p class="text-muted mb-0">
                    @plant.Species
                </p>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary"
                        @onclick="EditPlant">
                    Edit
                </button>

                <button class="btn btn-outline-secondary"
                        @onclick="BackToPlants">
                    Back
                </button>
            </div>
        </div>

        @if (plant.IsArchived)
        {
            <div class="alert alert-warning" role="alert">
                This plant is archived.
            </div>
        }

        <div class="row g-4">

            <div class="col-12 col-lg-6">
                <div class="card h-100">

                    <div class="card-header">
                        Plant information
                    </div>

                    <div class="card-body">

                        <dl class="row mb-0">

                            <dt class="col-sm-5">
                                Name
                            </dt>

                            <dd class="col-sm-7">
                                @plant.Name
                            </dd>

                            <dt class="col-sm-5">
                                Species
                            </dt>

                            <dd class="col-sm-7">
                                @plant.Species
                            </dd>

                            <dt class="col-sm-5">
                                Date planted
                            </dt>

                            <dd class="col-sm-7">
                                @plant.DatePlanted?.ToShortDateString()
                            </dd>

                        </dl>

                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card h-100">

                    <div class="card-header">
                        Watering
                    </div>

                    <div class="card-body">

                        <dl class="row mb-4">

                            <dt class="col-sm-6">
                                Last watered
                            </dt>

                            <dd class="col-sm-6">
                                @(plant.LastWatered?.ToShortDateString() ?? "Never")
                            </dd>

                            <dt class="col-sm-6">
                                Watering interval
                            </dt>

                            <dd class="col-sm-6">
                                @if (plant.WateringInterval.HasValue)
                                {
                                    @($"{plant.WateringInterval} days")
                                }
                                else
                                {
                                    <span>Not configured</span>
                                }
                            </dd>

                            <dt class="col-sm-6">
                                Next watering
                            </dt>

                            <dd class="col-sm-6">
                                @GetNextWateringDate()
                            </dd>

                        </dl>

                        <div class="card mt-4">

                            <div class="card-header">
                                <h2 class="h5 mb-0">
                                    Watering history
                                </h2>
                            </div>

                            <div class="card-body p-0">

                                @if (wateringHistory.Count == 0)
                                {
                                    <div class="p-3 text-muted">
                                        This plant has not been watered yet.
                                    </div>
                                }
                                else
                                {
                                    <div class="list-group list-group-flush">

                                        @foreach (var watering in wateringHistory)
                                        {
                                            <div class="list-group-item
                                                d-flex
                                                justify-content-between
                                                align-items-center">

                                                <div>
                                                    <div class="fw-medium">
                                                        @GetWateringDate(watering.Date)
                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(watering.Note))
                                                    {
                                                        <div class="small text-muted">
                                                            @watering.Note
                                                        </div>
                                                    }
                                                </div>

                                                <span class="text-muted small">
                                                    @watering.Date.ToShortTimeString()
                                                </span>

                                            </div>
                                        }

                                    </div>
                                }

                            </div>
                        </div>

                        <button class="btn btn-primary w-100"
                                @onclick="WaterPlant"
                                disabled="@(plant.IsArchived || watering)">

                            @if (watering)
                            {
                                <span class="spinner-border spinner-border-sm me-2"
                                      aria-hidden="true"></span>

                                <span>Watering...</span>
                            }
                            else
                            {
                                <span>💧 Water plant</span>
                            }

                        </button>

                    </div>
                </div>
            </div>

        </div>

    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Plant? plant;

    private bool loading = true;

    private bool watering;

    private IReadOnlyList<Watering> wateringHistory = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadPlant();
    }

    private async Task LoadPlant()
    {
        loading = true;

        plant = null;
        wateringHistory = [];

        plant = await PlantService.GetPlantAsync(Id);

        if (plant is not null)
            wateringHistory = await PlantService.GetWateringHistoryAsync(Id);

        loading = false;
    }

    private async Task WaterPlant()
    {
        if (plant is null || plant.IsArchived || watering)
        {
            return;
        }

        watering = true;

        try
        {
            var success = await PlantService.WaterPlantAsync(plant.Id);

            if (success)
            {
                await LoadPlant();
            }
        }
        finally
        {
            watering = false;
        }
    }

    private void EditPlant()
    {
        if (plant is null)
        {
            return;
        }

        Navigation.NavigateTo($"/plants/edit/{plant.Id}");
    }

    private void BackToPlants()
    {
        Navigation.NavigateTo("/plants");
    }

    private string GetNextWateringDate()
    {
        if (plant?.LastWatered is null ||
            plant.WateringInterval is null)
        {
            return "Not configured";
        }

        var nextWatering =
            plant.LastWatered.Value.Date
                .AddDays(plant.WateringInterval.Value);

        return nextWatering.ToShortDateString();
    }

    private static string GetWateringDate(DateTime date)
    {
        var today = DateTime.Today;
        var wateringDate = date.Date;

        if (wateringDate == today)
        {
            return "Today";
        }

        if (wateringDate == today.AddDays(-1))
        {
            return "Yesterday";
        }

        return date.ToShortDateString();
    }
}
