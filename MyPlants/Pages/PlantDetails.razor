@page "/plants/{Id:guid}"

@using MyPlants.Extensions
@using MyPlants.Interfaces.IServices
@using MyPlants.Models
@using MyPlants.Resources
@using MyPlants.Components

@inject IPlantService PlantService
@inject NavigationManager Navigation

<PageTitle>@(plant?.Name ?? SharedResource.PlantDetails_PageTitle)</PageTitle>

@if (loading)
{
    <div class="container py-3">
        <p><em>@SharedResource.PlantDetails_Loading</em></p>
    </div>
}
else if (plant is null)
{
    <div class="container py-3">
        <div class="alert alert-warning" role="alert">
            @SharedResource.PlantDetails_PlantNotFound
        </div>

        <button type="button"
                class="btn btn-outline-secondary"
                @onclick="BackToPlants">
            ← @SharedResource.PlantDetails_BackToPlants
        </button>
    </div>
}
else
{
    <div class="container py-3">

        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h1>@plant.Name</h1>

                <p class="text-muted mb-0">
                    @plant.Species
                </p>
            </div>

            <div class="d-flex gap-2">
                <button type="button"
                        class="btn btn-primary"
                        @onclick="EditPlant">
                    @SharedResource.PlantDetails_Button_Edit
                </button>

                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="BackToPlants">
                    @SharedResource.PlantDetails_Button_Back
                </button>
            </div>
        </div>

        @if (plant.IsArchived)
        {
            <div class="alert alert-warning" role="alert">
                @SharedResource.PlantDetails_ArchivedPlant
            </div>
        }

        <div class="row g-4">

            <div class="col-12 col-lg-6">
                <div class="card h-100">

                    <div class="card-header">
                        @SharedResource.PlantDetails_PlantInformation
                    </div>

                    <div class="card-body">

                        <dl class="row mb-0">

                            <dt class="col-sm-5">
                                @SharedResource.PlantDetails_Name
                            </dt>

                            <dd class="col-sm-7">
                                @plant.Name
                            </dd>

                            <dt class="col-sm-5">
                                @SharedResource.PlantDetails_Species
                            </dt>

                            <dd class="col-sm-7">
                                @plant.Species
                            </dd>

                            <dt class="col-sm-5">
                                @SharedResource.PlantDetails_DatePlanted
                            </dt>

                            <dd class="col-sm-7">
                                @plant.DatePlanted?.ToDisplayDate()
                            </dd>

                        </dl>

                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card h-100">

                    <div class="card-header">
                        @SharedResource.PlantDetails_Watering
                    </div>

                    <div class="card-body">

                        <dl class="row mb-4">

                            <dt class="col-sm-6">
                                @SharedResource.PlantDetails_LastWatered
                            </dt>

                            <dd class="col-sm-6">
                                @(plant.LastWatered?.ToDisplayDate() ?? SharedResource.PlantDetails_LastWatered_Never)
                            </dd>

                            <dt class="col-sm-6">
                                @SharedResource.PlantDetails_WateringInterval
                            </dt>

                            <dd class="col-sm-6">
                                @if (plant.WateringInterval.HasValue)
                                {
                                    @($"{plant.WateringInterval} {SharedResource.PlantDetails_WateringInterval_Days}")
                                }
                                else
                                {
                                    <span>@SharedResource.PlantDetails_WateringInterval_NotConfigured</span>
                                }
                            </dd>

                            <dt class="col-sm-6">
                                @SharedResource.PlantDetails_NextWatering
                            </dt>

                            <dd class="col-sm-6">
                                @GetNextWateringDate()
                            </dd>

                        </dl>

                        <div class="card mt-4 mb-2">

                            <div class="card-header">
                                <h2 class="h5 mb-0">
                                    @SharedResource.PlantDetails_WateringHistory
                                </h2>
                            </div>

                            <div class="card-body p-0">

                                @if (wateringHistory.Count == 0)
                                {
                                    <div class="p-3 text-muted">
                                        @SharedResource.PlantDetails_WateringHistory_Empty
                                    </div>
                                }
                                else
                                {
                                    <div class="list-group list-group-flush">

                                        @foreach (var wateringEntry in wateringHistory)
                                        {
                                            <div class="list-group-item
                                                d-flex
                                                justify-content-between
                                                align-items-center">

                                                <div>
                                                    <div class="fw-medium">
                                                        @GetWateringDate(wateringEntry.Date)
                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(wateringEntry.Note))
                                                    {
                                                        <div class="small text-muted">
                                                            @wateringEntry.Note
                                                        </div>
                                                    }
                                                </div>

                                                @* Un arrosage saisi à une date passée n'a pas d'heure : on n'affiche pas "00:00". *@
                                                @if (HasTime(wateringEntry.Date))
                                                {
                                                    <span class="text-muted small">
                                                        @wateringEntry.Date.ToShortTimeString()
                                                    </span>
                                                }

                                            </div>
                                        }

                                    </div>
                                }

                            </div>
                        </div>

                        <button type="button"
                                class="btn btn-primary w-100 mb-2"
                                @onclick="WaterPlantNow"
                                disabled="@(plant.IsArchived || watering)">

                            @if (watering)
                            {
                                <span class="spinner-border spinner-border-sm me-2"
                                      aria-hidden="true"></span>

                                <span>@SharedResource.PlantDetails_WateringInProgress</span>
                            }
                            else
                            {
                                <span>@SharedResource.PlantDetails_WaterPlantNow</span>
                            }

                        </button>

                        <button type="button"
                                class="btn btn-secondary w-100"
                                @onclick="OpenWateringDialog"
                                disabled="@(plant.IsArchived || watering)">

                            @if (watering)
                            {
                                <span class="spinner-border spinner-border-sm me-2"
                                      aria-hidden="true"></span>

                                <span>@SharedResource.PlantDetails_WateringInProgress</span>
                            }
                            else
                            {
                                <span>@SharedResource.PlantDetails_WaterPlantDateOnPastDate</span>
                            }

                        </button>

                    </div>
                </div>
            </div>

        </div>

    </div>

    @if (showWateringDialog && plant is not null)
    {
        <div class="watering-modal-backdrop">
            <div class="watering-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="watering-modal-title">

                <h2 id="watering-modal-title" class="h5 mb-3">
                    @SharedResource.PlantDetails_WaterPlantDateOnPastDate
                </h2>

                <label for="wateringDate" class="form-label">
                    @SharedResource.PlantDetails_WateringDate_Label
                </label>

                <DateSelector id="wateringDate"
                              max="DateTime.Today"
                              @bind="selectedWateringDate"
                              ValueChanged="@(d => selectedWateringDate = d ?? DateTime.Today)" />

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="CancelWateringDialog"
                            disabled="@savingWatering">
                        @SharedResource.Plants_Cancel
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SaveWatering"
                            disabled="@savingWatering">
                        @if (savingWatering)
                        {
                            <span class="spinner-border spinner-border-sm me-2"
                                  aria-hidden="true"></span>
                        }
                        @SharedResource.Plants_Save
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    // Format attendu par <input type="date"> (indépendant de la langue de l'application).
    private const string HtmlDateFormat = "yyyy-MM-dd";

    [Parameter]
    public Guid Id { get; set; }

    private Plant? plant;

    private bool loading = true;

    private bool watering;

    private IReadOnlyList<Watering> wateringHistory = [];

    private bool showWateringDialog;

    private bool savingWatering;

    private DateTime selectedWateringDate = DateTime.Today;

    private static string MaxWateringDate => DateTime.Today.ToString(HtmlDateFormat);

    protected override async Task OnInitializedAsync()
    {
        await LoadPlant();
    }

    // showLoader = false : rafraîchit les données sans remplacer toute la page par
    // le message de chargement (évite le clignotement après un arrosage).
    private async Task LoadPlant(bool showLoader = true)
    {
        if (showLoader)
        {
            loading = true;
            plant = null;
            wateringHistory = [];
        }

        plant = await PlantService.GetPlantAsync(Id);

        wateringHistory = plant is null
            ? []
            : await PlantService.GetWateringHistoryAsync(Id);

        loading = false;
    }

    private async Task WaterPlantNow()
    {
        if (plant is null || plant.IsArchived || watering)
            return;

        watering = true;

        try
        {
            var success = await PlantService.WaterPlantAsync(plant.Id);

            if (success)
            {
                await LoadPlant(showLoader: false);
            }
        }
        finally
        {
            watering = false;
        }
    }

    private void EditPlant()
    {
        if (plant is null)
        {
            return;
        }

        Navigation.NavigateToWithBaseUrl($"plants/edit/{plant.Id}");
    }

    private void BackToPlants()
    {
        Navigation.NavigateToWithBaseUrl("plants");
    }

    private string GetNextWateringDate()
    {
        if (plant?.LastWatered is null ||
            plant.WateringInterval is null)
        {
            return SharedResource.PlantDetails_WateringInterval_NotConfigured;
        }

        var nextWatering =
            plant.LastWatered.Value.Date
                .AddDays(plant.WateringInterval.Value);

        return nextWatering.ToDisplayDate();
    }

    private static bool HasTime(DateTime date)
    {
        return date.TimeOfDay != TimeSpan.Zero;
    }

    private static string GetWateringDate(DateTime date)
    {
        var today = DateTime.Today;
        var wateringDate = date.Date;

        if (wateringDate == today)
        {
            return SharedResource.PlantDetails_WateringDate_Today;
        }

        if (wateringDate == today.AddDays(-1))
        {
            return SharedResource.PlantDetails_WateringDate_Yesterday;
        }

        return date.ToShortDateString();
    }

    private void OpenWateringDialog()
    {
        if (plant is null || plant.IsArchived || watering)
            return;

        selectedWateringDate = DateTime.Today;
        showWateringDialog = true;
    }

    private void CancelWateringDialog()
    {
        if (savingWatering)
            return;

        showWateringDialog = false;
    }

    private async Task SaveWatering()
    {
        if (plant is null || plant.IsArchived || savingWatering)
            return;

        var chosenDate = selectedWateringDate.Date;

        if (chosenDate > DateTime.Today)
            return;

        savingWatering = true;

        try
        {
            // Pour aujourd'hui, on garde l'heure réelle ; pour une date passée, la date seule.
            var wateringDate = chosenDate == DateTime.Today
                ? DateTime.Now
                : chosenDate;

            await PlantService.WaterPlantAsync(plant.Id, wateringDate);

            showWateringDialog = false;
            await LoadPlant(showLoader: false);
        }
        finally
        {
            savingWatering = false;
        }
    }
}
