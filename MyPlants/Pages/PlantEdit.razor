@page "/plants/edit/{Id:guid}"

@using MyPlants.Models
@using MyPlants.Interfaces.IServices

@inject IPlantService PlantService
@inject NavigationManager Navigation

<PageTitle>@(plant?.Name is null ? "Edit Plant" : $"Edit {plant.Name}")</PageTitle>

<div class="container py-3">

    @if (loading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (plant is null)
    {
        <div class="alert alert-warning" role="alert">
            Plant not found.
        </div>

        <button class="btn btn-outline-secondary"
                @onclick="BackToPlants">
            ← Back to plants
        </button>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1>Edit Plant</h1>
                <p class="text-muted mb-0">
                    Update the information about your plant.
                </p>
            </div>

            <button class="btn btn-outline-secondary"
                    @onclick="Cancel">
                Cancel
            </button>
        </div>

        <div class="card">
            <div class="card-body">

                <EditForm Model="@plant"
                          OnValidSubmit="@SavePlant">

                    <DataAnnotationsValidator />

                    <ValidationSummary />

                    <div class="mb-3">
                        <label for="name" class="form-label">
                            Name
                        </label>

                        <InputText id="name"
                                   class="form-control"
                                   @bind-Value="plant.Name" />

                        <ValidationMessage For="@(() => plant.Name)" />
                    </div>

                    <div class="mb-3">
                        <label for="species" class="form-label">
                            Species
                        </label>

                        <InputText id="species"
                                   class="form-control"
                                   @bind-Value="plant.Species" />

                        <ValidationMessage For="@(() => plant.Species)" />
                    </div>

                    <div class="mb-3">
                        <label for="datePlanted" class="form-label">
                            Date planted
                        </label>

                        <InputDate id="datePlanted"
                                   class="form-control"
                                   @bind-Value="plant.DatePlanted" />

                        <ValidationMessage For="@(() => plant.DatePlanted)" />
                    </div>

                    <div class="mb-3">
                        <label for="wateringInterval" class="form-label">
                            Watering interval
                        </label>

                        <div class="input-group">
                            <InputNumber id="wateringInterval"
                                         class="form-control"
                                         @bind-Value="plant.WateringInterval" />

                            <span class="input-group-text">
                                days
                            </span>
                        </div>

                        <ValidationMessage For="@(() => plant.WateringInterval)" />
                    </div>

                    <div class="form-check mb-4">
                        <InputCheckbox id="archived"
                                       class="form-check-input"
                                       @bind-Value="plant.IsArchived" />

                        <label for="archived"
                               class="form-check-label">
                            Archived
                        </label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="Cancel">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@saving">
                            @if (saving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"
                                      aria-hidden="true">
                                </span>

                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Save changes</span>
                            }
                        </button>

                    </div>

                </EditForm>

            </div>
        </div>
    }
</div>

@code {

    [Parameter]
    public Guid Id { get; set; }

    private Plant? plant;

    private bool loading = true;
    private bool saving;

    protected override async Task OnParametersSetAsync()
    {
        await LoadPlant();
    }

    private async Task LoadPlant()
    {
        loading = true;
        plant = null;

        plant = await PlantService.GetPlantAsync(Id);

        loading = false;
    }

    private async Task SavePlant()
    {
        if (plant is null)
        {
            return;
        }

        saving = true;

        try
        {
            await PlantService.UpdatePlantAsync(plant);

            Navigation.NavigateTo($"/plants/{plant.Id}");
        }
        finally
        {
            saving = false;
        }
    }

    private void Cancel()
    {
        if (plant is null)
        {
            BackToPlants();
            return;
        }

        Navigation.NavigateTo($"/plants/{plant.Id}");
    }

    private void BackToPlants()
    {
        Navigation.NavigateTo("/plants");
    }
}
