@page "/plants/add"

@using MyPlants.Models
@using MyPlants.Interfaces.IServices

@inject IPlantService PlantService
@inject NavigationManager Navigation

<PageTitle>Add Plant</PageTitle>

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Add Plant</h1>
            <p class="text-muted mb-0">Add a new plant to your collection.</p>
        </div>

        <a href="/plants" class="btn btn-outline-secondary">
            Cancel
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <EditForm Model="@plant" OnValidSubmit="@SavePlant">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="name" class="form-label">Name</label>
                    <InputText id="name"
                               class="form-control"
                               @bind-Value="plant.Name" />

                    <ValidationMessage For="@(() => plant.Name)" />
                </div>

                <div class="mb-3">
                    <label for="species" class="form-label">Species</label>
                    <InputText id="species"
                               class="form-control"
                               @bind-Value="plant.Species" />

                    <ValidationMessage For="@(() => plant.Species)" />
                </div>

                <div class="mb-3">
                    <label for="datePlanted" class="form-label">Date planted</label>
                    <InputDate id="datePlanted"
                               class="form-control"
                               @bind-Value="plant.DatePlanted" />

                    <ValidationMessage For="@(() => plant.DatePlanted)" />
                </div>

                <div class="mb-3">
                    <label for="wateringInterval" class="form-label">
                        Watering interval
                    </label>

                    <div class="input-group">
                        <InputNumber id="wateringInterval"
                                     class="form-control"
                                     @bind-Value="plant.WateringInterval" />

                        <span class="input-group-text">days</span>
                    </div>

                    <ValidationMessage For="@(() => plant.WateringInterval)" />
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="/plants" class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-primary">
                        Add plant
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private Plant plant = new()
    {
        DatePlanted = DateTime.Today,
        WateringInterval = 7
    };

    private async Task SavePlant()
    {
        await PlantService.AddPlantAsync(plant);
        Navigation.NavigateTo("plants");
    }
}

