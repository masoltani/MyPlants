@page "/plants/add"

@using MyPlants.Components
@using MyPlants.Extensions
@using MyPlants.Interfaces.IServices
@using MyPlants.Models
@using MyPlants.Resources

@inject IPlantService PlantService
@inject NavigationManager Navigation

<PageTitle>@SharedResource.PlantAdd_Title</PageTitle>

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>@SharedResource.PlantAdd_SubTitle</h1>
            <p class="text-muted mb-0">@SharedResource.PlantAdd_DescriptionPage</p>
        </div>

        <button type="button"
                class="btn btn-outline-secondary"
                @onclick="Cancel">
            @SharedResource.Plants_Cancel
        </button>
    </div>

    <div class="card">
        <div class="card-body">
            <EditForm Model="@plant" OnValidSubmit="@SavePlant">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="name" class="form-label">@SharedResource.Plant_Name</label>
                    <InputText id="name"
                               class="form-control"
                               @bind-Value="plant.Name" />

                    <ValidationMessage For="@(() => plant.Name)" />
                </div>

                <div class="mb-3">
                    <label for="species" class="form-label">@SharedResource.Plants_Species</label>
                    <InputText id="species"
                               class="form-control"
                               @bind-Value="plant.Species" />

                    <ValidationMessage For="@(() => plant.Species)" />
                </div>

                <div class="mb-3">
                    <label for="datePlanted" class="form-label">@SharedResource.Plants_DatePlanted</label>
                    <DateSelector id="datePlanted" 
                                  Max="DateTime.Today" 
                                  @bind-Value="plant.DatePlanted"/>

                    <ValidationMessage For="@(() => plant.DatePlanted)" />
                </div>

                <div class="mb-3">
                    <label for="wateringInterval" class="form-label">
                        @SharedResource.Plants_WateringInterval
                    </label>

                    <div class="input-group">
                        <InputNumber id="wateringInterval"
                                     class="form-control"
                                     @bind-Value="plant.WateringInterval" />

                        <span class="input-group-text">@SharedResource.PlantAdd_WateringInterval_Days</span>
                    </div>

                    <ValidationMessage For="@(() => plant.WateringInterval)" />
                </div>

                <div class="d-flex justify-content-end gap-2">
                    @* type="button" : sans lui, ce bouton soumettrait le formulaire. *@
                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="Cancel"
                            disabled="@saving">
                        @SharedResource.Plants_Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@saving">
                        @SharedResource.Plants_Save
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private bool saving;

    private Plant plant = new()
    {
        DatePlanted = DateTime.Today,
        WateringInterval = 7
    };

    private async Task SavePlant()
    {
        // Évite un double enregistrement en cas de double clic.
        if (saving)
            return;

        saving = true;

        try
        {
            await PlantService.AddPlantAsync(plant);
            Navigation.NavigateToWithBaseUrl("plants");
        }
        finally
        {
            saving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateToWithBaseUrl("plants");
    }
}
