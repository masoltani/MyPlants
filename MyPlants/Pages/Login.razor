@page "/login"

@using MyPlants.Interfaces.IServices
@using MyPlants.Extensions
@using MyPlants.Resources

@inject IUserSessionService UserSession
@inject NavigationManager Navigation

<PageTitle>Connexion - MyPlants</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h1 class="h3 mb-4 text-center">
                        Connexion
                    </h1>

                    <form @onsubmit="LoginAsync"
                          @onsubmit:preventDefault="true">

                        <div class="mb-3">
                            <label for="username"
                                   class="form-label">
                                @SharedResource.Auth_Email
                            </label>

                            <input id="username"
                                   class="form-control"
                                   @bind="email"
                                   autocomplete="username"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label for="password"
                                   class="form-label">
                                @SharedResource.Auth_Password
                            </label>

                            <input id="password"
                                   type="password"
                                   class="form-control"
                                   @bind="password"
                                   autocomplete="current-password"
                                   required />
                            <div class="mb-3 text-end"><a href="forgot-password">@SharedResource.Auth_ForgotPassword</a></div>
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger"
                                 role="alert">
                                @errorMessage
                            </div>
                        }

                        <button type="submit"
                                class="btn btn-primary w-100 mb-2">
                            @SharedResource.Auth_Login
                        </button>

                    </form>

                    <a href="signup">@SharedResource.Auth_SignUp</a>

                    <button class="btn btn-outline-secondary w-100"
                            @onclick="ContinueAsGuest">
                        @SharedResource.Auth_ContinueWithoutAccount
                    </button>

                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string? errorMessage;

    private async Task LoginAsync()
    {
        errorMessage = null;

        var success = await UserSession.LoginAsync(email, password);

        if (success)
        {
            Navigation.NavigateToWithBaseUrl("");
        }
        else
        {
            errorMessage = UserSession.LastError ?? @SharedResource.Auth_Login_Failed;
        }
    }

    private void ContinueAsGuest()
    {
        Navigation.NavigateToWithBaseUrl("");
    }
}