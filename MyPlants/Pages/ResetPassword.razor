@page "/reset-password"

@using MyPlants.Businesses
@using MyPlants.Interfaces.IServices
@using MyPlants.Models
@using MyPlants.Resources

@inject IUserSessionService UserSession

<PageTitle>@SharedResource.Auth_ResetPassword_Title - MyPlants</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h1 class="h3 mb-3 text-center">
                        @SharedResource.Auth_ResetPassword_Title
                    </h1>

                    @if (done)
                    {
                        <div class="alert alert-success" role="status">
                            @SharedResource.Auth_PasswordUpdated
                        </div>

                        <a class="btn btn-primary w-100" href="plants">
                            @SharedResource.NavMenu_Plants
                        </a>
                    }
                    else if (UserSession.AuthLink != AuthLinkStatus.Recovery)
                    {
                        @* Page ouverte sans lien valide (lien expiré, déjà utilisé, ou page rechargée). *@
                        <div class="alert alert-warning" role="alert">
                            @SharedResource.Auth_LinkInvalid
                        </div>

                        <a class="btn btn-primary w-100" href="forgot-password">
                            @SharedResource.Auth_ForgotPassword
                        </a>
                    }
                    else
                    {
                        <form @onsubmit="SaveAsync"
                              @onsubmit:preventDefault="true">

                            <div class="mb-3">
                                <label for="newPassword" class="form-label">
                                    @SharedResource.Auth_NewPassword
                                </label>

                                <input id="newPassword"
                                       type="password"
                                       class="form-control"
                                       @bind="newPassword"
                                       @bind:event="oninput"
                                       autocomplete="new-password"
                                       required />
                            </div>

                            <div class="mb-3">
                                <label for="confirmPassword" class="form-label">
                                    @SharedResource.Auth_ConfirmPassword
                                </label>

                                <input id="confirmPassword"
                                       type="password"
                                       class="form-control"
                                       @bind="confirmPassword"
                                       @bind:event="oninput"
                                       autocomplete="new-password"
                                       required />
                            </div>

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger" role="alert">
                                    @errorMessage
                                </div>
                            }

                            <button type="submit"
                                    class="btn btn-primary w-100"
                                    disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"
                                          aria-hidden="true"></span>
                                }
                                @SharedResource.Auth_SavePassword
                            </button>

                        </form>
                    }

                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string? errorMessage;
    private bool saving;
    private bool done;

    private async Task SaveAsync()
    {
        if (saving)
            return;

        errorMessage = PasswordRules.Validate(newPassword, confirmPassword);

        if (errorMessage is not null)
            return;

        saving = true;

        try
        {
            if (await UserSession.UpdatePasswordAsync(newPassword))
            {
                done = true;
                newPassword = confirmPassword = string.Empty;
            }
            else
            {
                errorMessage = UserSession.LastError ?? SharedResource.Error_Generic;
            }
        }
        finally
        {
            saving = false;
        }
    }
}
