@inherits LayoutComponentBase

@implements IDisposable

@using MyPlants.Components
@using MyPlants.Extensions
@using MyPlants.Interfaces.IServices
@using MyPlants.Models
@using MyPlants.Resources

@inject IUserSessionService UserSession
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-end align-items-center gap-3">
            <SyncButton OnSynced="ReloadContent" />

            @if (UserSession.IsLoggedIn)
            {
                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="LogoutAsync">
                    @SharedResource.Auth_Logout
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-primary"
                        @onclick="GoToLogin">
                    @SharedResource.Auth_Login
                </button>
            }
        </div>

        @* Changer la clé recrée la page affichée : elle relit alors ses données
           (utile après une synchronisation qui a pu modifier la liste des plantes). *@
        <article class="content px-4" @key="contentVersion">
            @Body
        </article>
    </main>
</div>

@code {
    private int contentVersion;

    protected override void OnInitialized()
    {
        UserSession.OnSessionChanged += OnSessionChanged;
        if (UserSession.AuthLink != AuthLinkStatus.None) 
            Navigation.NavigateToWithBaseUrl("reset-password");
    }

    private void ReloadContent()
    {
        contentVersion++;
    }

    // Garde le bouton Se connecter / Se déconnecter à jour, quel que soit l'origine du changement.
    private void OnSessionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void GoToLogin()
    {
        Navigation.NavigateToWithBaseUrl("login");
    }

    private async Task LogoutAsync()
    {
        await UserSession.LogoutAsync();
        Navigation.NavigateToWithBaseUrl("");
    }

    public void Dispose()
    {
        UserSession.OnSessionChanged -= OnSessionChanged;
    }
}
