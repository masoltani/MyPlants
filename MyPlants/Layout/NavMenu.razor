@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@using MyPlants.Resources

@inject IWebAssemblyHostEnvironment HostEnvironment

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">MyPlants</a>
        <button title="@SharedResource.NavMenu_Toggle" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="plants">
                <span class="bi bi-flower1-fill-nav-menu" aria-hidden="true"></span> @SharedResource.NavMenu_Plants
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @SharedResource.NavMenu_Settings
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="about">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @SharedResource.NavMenu_About
            </NavLink>
        </div>

        @* Page de test de la synchronisation : visible seulement en développement. *@
        @if (HostEnvironment.IsDevelopment())
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="sync-test">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> SyncTest
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
