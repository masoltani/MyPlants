@using MyPlants.Services

@inject LocalizationService Localization
@inject NavigationManager Navigation

<select class="form-select form-select-sm"
        @onchange="ChangeLanguage">

    <option value="en-US" selected="@(Localization.CurrentCulture.Name == "en-US")">English</option>
    <option value="fr-FR" selected="@(Localization.CurrentCulture.Name == "fr-FR")">Français</option>
    <option value="ar-SA" selected="@(Localization.CurrentCulture.Name == "ar-SA")">العربية</option>

</select>

@code {

    protected override void OnInitialized()
    {
        Localization.OnCultureChanged += OnCultureChanged;
    }

    private async Task ChangeLanguage(ChangeEventArgs e)
    {
        if (e.Value is string culture)
        {
            await Localization.SetCultureAsync(culture);
            Navigation.NavigateTo(Navigation.BaseUri, forceLoad: true); // Force full page reload to apply the new culture
        }
    }

    private void OnCultureChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Localization.OnCultureChanged -= OnCultureChanged;
    }
}